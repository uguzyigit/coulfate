@model Nop.Web.Areas.Admin.Models.Catalog.ProductAttributeMappingModel

@{
    Layout = "_AdminPopupLayout";
    ViewBag.PageTitle = "Ürün Niteliği Ekle";
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try { window.opener.document.forms['@(Context.Request.Query["formId"])']['@(Context.Request.Query["btnId"])'].click(); }
        catch (e) { }
        window.close();
    </script>
}

<form asp-controller="VendorProduct" asp-action="ProductAttributeMappingCreatePopup"
      asp-route-productId="@Model.ProductId"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Ürün Niteliği Ekle
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                Kaydet
            </button>
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">
                            <input type="hidden" asp-for="ProductId" />
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <div class="label-wrapper"><label class="col-form-label">Nitelik</label><div title="Ürüne eklenecek niteliği seçin (örn: Renk, Beden)." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                                </div>
                                <div class="col-md-9">
                                    <nop-select asp-for="ProductAttributeId" asp-items="Model.AvailableProductAttributes" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <div class="label-wrapper"><label class="col-form-label">Görüntüleme Sırası</label><div title="Niteliğin ürün sayfasında görüntülenme sırasını belirleyin." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="DisplayOrder" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
