@model Nop.Web.Areas.Admin.Models.Catalog.ProductAttributeValueModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Nitelik Değeri Düzenle";
}

<form asp-controller="VendorProduct" asp-action="ProductAttributeValueEdit" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Nitelik Değeri Düzenle
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                Kaydet
            </button>
        </div>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ProductAttributeMappingId" />
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Name" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="Name" asp-required="true" />
                                    <span asp-validation-for="Name"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ColorSquaresRgb" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ColorSquaresRgb" />
                                    <span asp-validation-for="ColorSquaresRgb"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="PriceAdjustment" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="PriceAdjustment" />
                                    <span asp-validation-for="PriceAdjustment"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="Quantity" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="Quantity" />
                                    <span asp-validation-for="Quantity"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="IsPreSelected" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="IsPreSelected" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="DisplayOrder" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="DisplayOrder" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
