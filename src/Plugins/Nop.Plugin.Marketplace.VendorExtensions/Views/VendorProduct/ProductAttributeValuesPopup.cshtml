@model Nop.Web.Areas.Admin.Models.Catalog.ProductAttributeMappingModel

@using Nop.Web.Areas.Admin.Models.Catalog
@using Nop.Web.Framework.Models

@{
    Layout = "_AdminPopupLayout";
    ViewBag.PageTitle = $"Nitelik Değerleri - {Model.ProductAttribute}";
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try { window.opener.document.forms['@(Context.Request.Query["formId"])']['@(Context.Request.Query["btnId"])'].click(); }
        catch (e) { }
        window.close();
    </script>
}

<div class="content-header clearfix">
    <h1 class="float-left">
        Nitelik Değerleri - @Model.ProductAttribute
    </h1>
    <div class="float-right">
        <button type="button" onclick="window.close();" class="btn btn-default">
            <i class="fas fa-times"></i>
            Kapat
        </button>
    </div>
</div>
<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <!-- Values Grid -->
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-header">Mevcut Değerler</div>
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "productattributevalues-grid",
                            UrlRead = new DataUrl("ProductAttributeValueList", "VendorProduct", new RouteValueDictionary { [nameof(ProductAttributeValueSearchModel.ProductAttributeMappingId)] = Model.Id }),
                            UrlDelete = new DataUrl("ProductAttributeValueDelete", "VendorProduct", null),
                            UrlUpdate = new DataUrl("ProductAttributeValueUpdateInline", "VendorProduct", null),
                            Length = Model.ProductAttributeValueSearchModel.PageSize,
                            LengthMenu = Model.ProductAttributeValueSearchModel.AvailablePageSizes,
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(ProductAttributeValueModel.Name))
                                {
                                    Title = "Ad",
                                    Width = "200",
                                    Editable = true,
                                    EditType = EditType.String
                                },
                                new ColumnProperty(nameof(ProductAttributeValueModel.ColorSquaresRgb))
                                {
                                    Title = "Renk",
                                    Width = "100",
                                    Editable = true,
                                    EditType = EditType.String
                                },
                                new ColumnProperty(nameof(ProductAttributeValueModel.PriceAdjustment))
                                {
                                    Title = "Fiyat Farkı",
                                    Width = "100",
                                    Editable = true,
                                    EditType = EditType.Number
                                },
                                new ColumnProperty(nameof(ProductAttributeValueModel.Quantity))
                                {
                                    Title = "Miktar",
                                    Width = "80",
                                    Editable = true,
                                    EditType = EditType.Number
                                },
                                new ColumnProperty(nameof(ProductAttributeValueModel.DisplayOrder))
                                {
                                    Title = "Sıra",
                                    Width = "80",
                                    ClassName = NopColumnClassDefaults.CenterAll,
                                    Editable = true,
                                    EditType = EditType.Number
                                },
                                new ColumnProperty(nameof(ProductAttributeValueModel.Id))
                                {
                                    Title = "Düzenle",
                                    Width = "100",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderButtonsInlineEdit()
                                },
                                new ColumnProperty(nameof(ProductAttributeValueModel.Id))
                                {
                                    Title = "Sil",
                                    Width = "80",
                                    Render = new RenderButtonRemove("Sil"),
                                    ClassName = NopColumnClassDefaults.Button
                                }
                            }
                        })
                    </div>
                </div>
            </div>

            <!-- Add New Value Form -->
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-header">Yeni Değer Ekle</div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Ad</label><div title="Nitelik değerinin adını girin (örn: Kırmızı, XL)." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                            </div>
                            <div class="col-md-9">
                                <input type="text" id="newValueName" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Renk Kodu</label><div title="Renk karesi için RGB renk kodu (örn: #FF0000)." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                            </div>
                            <div class="col-md-9">
                                <input type="text" id="newValueColor" class="form-control" placeholder="#000000" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Fiyat Farkı</label><div title="Bu değer seçildiğinde uygulanacak fiyat farkını girin." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                            </div>
                            <div class="col-md-9">
                                <input type="number" id="newValuePriceAdjustment" class="form-control" value="0" step="0.01" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Miktar</label><div title="Bu değer için miktar bilgisini girin." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                            </div>
                            <div class="col-md-9">
                                <input type="number" id="newValueQuantity" class="form-control" value="0" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <div class="label-wrapper"><label class="col-form-label">Görüntüleme Sırası</label><div title="Değerlerin görüntülenme sırasını belirleyin." data-toggle="tooltip" class="ico-help"><i class="fas fa-circle-question"></i></div></div>
                            </div>
                            <div class="col-md-9">
                                <input type="number" id="newValueDisplayOrder" class="form-control" value="0" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="button" id="btnAddValue" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Değer Ekle
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(function() {
        $('#btnAddValue').click(function() {
            var name = $('#newValueName').val();
            if (!name || name.trim() === '') {
                alert('Lütfen değer adını girin.');
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                type: 'POST',
                url: '@Url.Action("ProductAttributeValueCreateInline", "VendorProduct")',
                data: {
                    productAttributeMappingId: @Model.Id,
                    name: name,
                    colorSquaresRgb: $('#newValueColor').val(),
                    priceAdjustment: $('#newValuePriceAdjustment').val() || 0,
                    quantity: $('#newValueQuantity').val() || 0,
                    displayOrder: $('#newValueDisplayOrder').val() || 0,
                    __RequestVerificationToken: token
                },
                success: function(data) {
                    if (data.Result) {
                        updateTable('#productattributevalues-grid');
                        $('#newValueName').val('');
                        $('#newValueColor').val('');
                        $('#newValuePriceAdjustment').val('0');
                        $('#newValueQuantity').val('0');
                        $('#newValueDisplayOrder').val('0');
                    } else {
                        alert(data.Message || 'Değer ekleme başarısız.');
                    }
                },
                error: function() {
                    alert('Değer eklenirken hata oluştu.');
                }
            });
        });
    });
</script>
