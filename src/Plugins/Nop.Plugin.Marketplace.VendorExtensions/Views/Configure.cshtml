@{
    Layout = "_ConfigurePlugin";
    ViewBag.PageTitle = "Marketplace Vendor Extensions";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        Marketplace Vendor Extensions v2.1
    </h1>
</div>

<div class="content">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-cogs"></i>
                    Cari Hesap Sistemi (v2.1)
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    <strong>Plugin Installed Successfully!</strong>
                </div>
                
                <div class="alert alert-info">
                    <h4><i class="fas fa-info-circle"></i> Native Vendor Integration + Cari Hesap</h4>
                    <p>Bu plugin, NopCommerce'in native Vendor sistemini genişletir:</p>
                    <ul>
                        <li><strong>Vendor Current Account:</strong> Satıcı borç-alacak takibi</li>
                        <li><strong>Transaction Tracking:</strong> Her mali hareketin kaydı</li>
                        <li><strong>Balance Management:</strong> Otomatik bakiye güncelleme</li>
                    </ul>
                </div>

                <h3 class="mt-4">Quick Links</h3>
                <div class="row">
                    <div class="col-md-4">
                        <a href="/Admin/Vendor/List" class="btn btn-primary btn-lg btn-block">
                            <i class="fas fa-users"></i> Manage Vendors
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Admin/Commission/Configure" class="btn btn-info btn-lg btn-block">
                            <i class="fas fa-percent"></i> Commission Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
