@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Komisyon Oranları";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        <i class="fas fa-percentage"></i>
        Komisyon Oranları
    </h1>
</div>

<div class="content">
    <div class="card card-default">
        <div class="card-header">
            <div class="card-title">
                <i class="fas fa-list"></i>
                Kategori Komisyon Oranları
            </div>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                Bu sayfada kategori bazlı komisyon oranlarını görüntüleyebilirsiniz.
                Komisyon oranları, satışlarınızdan kesilen yüzdeyi gösterir.
            </div>

            <table class="table table-bordered table-hover table-striped">
                <thead class="thead-light">
                    <tr>
                        <th>Kategori Adı</th>
                        <th width="150" class="text-center">Komisyon Oranı (%)</th>
                    </tr>
                </thead>
                <tbody id="category-tbody">
                    <tr>
                        <td colspan="2" class="text-center">
                            <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function loadCommissionRates() {
            $.ajax({
                url: '@Url.Action("GetCommissionRatesList", "VendorExtensions", new { area = "Admin" })',
                type: 'POST',
                dataType: 'json',
                data: {
                    __RequestVerificationToken: getAntiForgeryToken()
                },
                success: function(result) {
                    var tbody = $('#category-tbody');
                    tbody.empty();

                    if (result.success) {
                        if (result.data && result.data.length > 0) {
                            $.each(result.data, function(index, item) {
                                var rateClass = item.rate > 20 ? 'text-danger' : (item.rate > 10 ? 'text-warning' : 'text-success');
                                var row = '<tr>' +
                                    '<td>' + escapeHtml(item.categoryName) + '</td>' +
                                    '<td class="text-center ' + rateClass + '"><strong>%' + item.rate.toFixed(2) + '</strong></td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                        } else {
                            tbody.html('<tr><td colspan="2" class="text-center text-muted">Kategori bulunamadı.</td></tr>');
                        }
                    } else {
                        tbody.html('<tr><td colspan="2" class="text-center text-danger"><i class="fas fa-exclamation-triangle"></i> ' + (result.error || result.message || 'Hata oluştu') + '</td></tr>');
                    }
                },
                error: function(xhr, status, error) {
                    var tbody = $('#category-tbody');
                    tbody.html('<tr><td colspan="2" class="text-center text-danger"><i class="fas fa-exclamation-triangle"></i> Hata: ' + error + '</td></tr>');
                    console.error('Error loading commission rates:', error);
                }
            });
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Load on page load
        loadCommissionRates();
    });
</script>
