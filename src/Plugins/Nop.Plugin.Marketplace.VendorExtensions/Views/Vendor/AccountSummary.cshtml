@{
    Layout = "_AdminLayout";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        <i class="fas fa-wallet"></i>
        Hesap Özeti
    </h1>
</div>

<div class="content">
    <div class="row">
        <div class="col-md-4">
            <div class="info-box bg-info">
                <span class="info-box-icon"><i class="fas fa-wallet"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Güncel Bakiye</span>
                    <span class="info-box-number">@ViewBag.Balance TL</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box bg-success">
                <span class="info-box-icon"><i class="fas fa-arrow-up"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Toplam Alacak</span>
                    <span class="info-box-number">@ViewBag.TotalCredit TL</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-box bg-danger">
                <span class="info-box-icon"><i class="fas fa-arrow-down"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Toplam Borç</span>
                    <span class="info-box-number">@ViewBag.TotalDebit TL</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-default">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-info-circle"></i>
                Hesap Bilgileri
            </h3>
        </div>
        <div class="card-body">
            <p><strong>Satıcı:</strong> @ViewBag.VendorName</p>
            <p><strong>Son Güncelleme:</strong> @ViewBag.LastUpdated</p>
            <hr/>
            <p class="text-muted">
                <i class="fas fa-info-circle"></i>
                Detaylı işlem geçmişi için "İşlem Geçmişi" menüsünü kullanabilirsiniz.
            </p>
        </div>
    </div>
</div>
