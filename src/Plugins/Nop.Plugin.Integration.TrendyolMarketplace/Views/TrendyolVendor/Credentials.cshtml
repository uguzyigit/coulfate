@model VendorCredentialModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Integration.TrendyolMarketplace.Menu.Vendor.Credentials").Text;
    NopHtml.SetActiveMenuItemSystemName("VendorPanel.Trendyol.Credentials");
}

<style>
    .label-wrapper {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }
    .label-wrapper > label {
        margin-right: 5px;
        margin-bottom: 0;
    }
</style>

<form asp-controller="TrendyolVendor" asp-action="SaveCredentials" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="VendorId" />

    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Integration.TrendyolMarketplace.Menu.Vendor.Credentials")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Plugins.Integration.TrendyolMarketplace.Button.Save")
            </button>
            <button type="button" class="btn btn-info" id="btnTestConnection">
                <i class="fas fa-plug"></i>
                @T("Plugins.Integration.TrendyolMarketplace.Button.TestConnection")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="callout callout-info">
                <h5><i class="fas fa-info-circle"></i> Trendyol API Bilgileri</h5>
                <p>Bu bilgileri Trendyol Satici Paneli > Entegrasyon > API Entegrasyonu bolumunden alabilirsiniz.</p>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <h5>API Kimlik Bilgileri</h5>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="TrendyolSupplierId" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="TrendyolSupplierId" />
                            <span asp-validation-for="TrendyolSupplierId"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="IntegrationReferenceCode" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="IntegrationReferenceCode" />
                            <span asp-validation-for="IntegrationReferenceCode"></span>
                            <small class="text-muted">Trendyol'daki "Entegrasyon Referans Kodu" alani</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ApiKey" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="ApiKey" />
                            <span asp-validation-for="ApiKey"></span>
                            <small class="text-muted">Trendyol'daki "API Kullanici Adi" alani</small>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ApiSecret" />
                        </div>
                        <div class="col-md-8">
                            <input type="text" asp-for="ApiSecret" class="form-control" placeholder="@(Model.HasCredentials ? "Mevcut sifreyi korumak icin bos birakin" : "Token degerini girin")" />
                            <span asp-validation-for="ApiSecret"></span>
                            <small class="text-muted">
                                <strong>Trendyol'daki "Token" alanini dogrudan yapistirebilirsiniz.</strong>
                                (Ornek: R1hCQTlr...S28=)
                                @(Model.HasCredentials ? " Mevcut degeri korumak icin bos birakin." : "")
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <h5>Senkronizasyon Ayarlari</h5>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="IsActive" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="IsActive" />
                            <span asp-validation-for="IsActive"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="AutoSyncEnabled" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="AutoSyncEnabled" />
                            <span asp-validation-for="AutoSyncEnabled"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="SyncIntervalMinutes" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="SyncIntervalMinutes" />
                            <span asp-validation-for="SyncIntervalMinutes"></span>
                        </div>
                    </div>
                    @if (Model.HasCredentials)
                    {
                        <div class="form-group row">
                            <div class="col-md-4">
                                <label>Son Senkronizasyon</label>
                            </div>
                            <div class="col-md-8">
                                <p class="form-control-static">@Model.LastSyncOnDisplay</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</form>

<script asp-location="Footer">
    $(document).ready(function () {
        $('#btnTestConnection').click(function () {
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Test ediliyor...');

            // Get antiforgery token from the form
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("TestConnection", "TrendyolVendor")',
                type: 'POST',
                data: { __RequestVerificationToken: token },
                timeout: 35000, // 35 second timeout
                success: function (data) {
                    if (data.success) {
                        displayBarNotification(data.message, 0, 5000);
                    } else {
                        displayBarNotification(data.message, 1, 0);
                    }
                },
                error: function (xhr, status, error) {
                    if (status === 'timeout') {
                        displayBarNotification('Baglanti zaman asimina ugradi. Lutfen API bilgilerinizi kontrol edin.', 1, 0);
                    } else {
                        var errorMsg = 'Baglanti testi sirasinda bir hata olustu';
                        if (xhr.responseText) {
                            try {
                                var response = JSON.parse(xhr.responseText);
                                if (response.message) errorMsg = response.message;
                            } catch (e) {
                                errorMsg += ': ' + error;
                            }
                        } else {
                            errorMsg += ': ' + error;
                        }
                        displayBarNotification(errorMsg, 1, 0);
                    }
                },
                complete: function () {
                    btn.prop('disabled', false).html('<i class="fas fa-plug"></i> @T("Plugins.Integration.TrendyolMarketplace.Button.TestConnection")');
                }
            });
        });
    });
</script>
