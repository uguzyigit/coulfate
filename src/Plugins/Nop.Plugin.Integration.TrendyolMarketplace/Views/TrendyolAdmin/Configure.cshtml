@model ConfigurationModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Integration.TrendyolMarketplace.Menu.Admin.Configure").Text;
    NopHtml.SetActiveMenuItemSystemName("Marketplace.Trendyol.Configure");
}

<style>
    .label-wrapper {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }
    .label-wrapper > label {
        margin-right: 5px;
        margin-bottom: 0;
    }
</style>

<form asp-controller="TrendyolAdmin" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Integration.TrendyolMarketplace.Menu.Admin.Configure")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-header">
                    <h5>@T("Admin.Configuration.Settings")</h5>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="Enabled" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="Enabled" />
                            <span asp-validation-for="Enabled"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ApiBaseUrl" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="ApiBaseUrl" />
                            <span asp-validation-for="ApiBaseUrl"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="DefaultProductSyncIntervalMinutes" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="DefaultProductSyncIntervalMinutes" />
                            <span asp-validation-for="DefaultProductSyncIntervalMinutes"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="DefaultStockPriceSyncIntervalMinutes" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="DefaultStockPriceSyncIntervalMinutes" />
                            <span asp-validation-for="DefaultStockPriceSyncIntervalMinutes"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="CategoryBrandSyncIntervalHours" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="CategoryBrandSyncIntervalHours" />
                            <span asp-validation-for="CategoryBrandSyncIntervalHours"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ApiRequestDelayMs" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="ApiRequestDelayMs" />
                            <span asp-validation-for="ApiRequestDelayMs"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="MaxRetryCount" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="MaxRetryCount" />
                            <span asp-validation-for="MaxRetryCount"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ApiPageSize" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="ApiPageSize" />
                            <span asp-validation-for="ApiPageSize"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="AutoCreateManufacturers" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="AutoCreateManufacturers" />
                            <span asp-validation-for="AutoCreateManufacturers"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="DownloadProductImages" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="DownloadProductImages" />
                            <span asp-validation-for="DownloadProductImages"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="PublishImportedProducts" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="PublishImportedProducts" />
                            <span asp-validation-for="PublishImportedProducts"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="SkipUnmappedCategories" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="SkipUnmappedCategories" />
                            <span asp-validation-for="SkipUnmappedCategories"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ImportSpecificationAttributes" />
                        </div>
                        <div class="col-md-8">
                            <nop-editor asp-for="ImportSpecificationAttributes" />
                            <span asp-validation-for="ImportSpecificationAttributes"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danger Zone - Data Management -->
            <div class="card card-danger">
                <div class="card-header">
                    <h5><i class="fas fa-exclamation-triangle"></i> @T("Plugins.Integration.TrendyolMarketplace.PurgeData.DangerZone")</h5>
                </div>
                <div class="card-body">
                    <div class="callout callout-danger">
                        <h5>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Warning")</h5>
                        <p>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Description")</p>
                        <ul>
                            <li>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Item.Credentials")</li>
                            <li>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Item.CategoryMappings")</li>
                            <li>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Item.BrandMappings")</li>
                            <li>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Item.ProductTracking")</li>
                            <li>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.Item.SyncLogs")</li>
                        </ul>
                        <p><strong>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.NopProductsNote")</strong></p>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <label>@T("Plugins.Integration.TrendyolMarketplace.PurgeData.ConfirmLabel")</label>
                        </div>
                        <div class="col-md-8">
                            <div class="input-group">
                                <input type="text" id="purgeConfirmText" class="form-control" placeholder="SIL" maxlength="3" style="max-width: 150px;" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-danger" id="btnPurgeData">
                                        <i class="fas fa-trash"></i>
                                        @T("Plugins.Integration.TrendyolMarketplace.PurgeData.Button")
                                    </button>
                                </div>
                            </div>
                            <small class="text-muted">@T("Plugins.Integration.TrendyolMarketplace.PurgeData.ConfirmHint")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

<script asp-location="Footer">
    $(document).ready(function () {
        $('#btnPurgeData').click(function () {
            var confirmText = $('#purgeConfirmText').val();
            if (confirmText !== 'SIL') {
                displayBarNotification('@T("Plugins.Integration.TrendyolMarketplace.PurgeData.ConfirmationRequired")', 1, 0);
                return;
            }

            if (!confirm('@T("Plugins.Integration.TrendyolMarketplace.PurgeData.FinalConfirm")')) {
                return;
            }

            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> @T("Plugins.Integration.TrendyolMarketplace.Common.Loading")');

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("PurgeAllData", "TrendyolAdmin")',
                type: 'POST',
                data: {
                    confirmText: confirmText,
                    __RequestVerificationToken: token
                },
                success: function (data) {
                    if (data.success) {
                        displayBarNotification(data.message, 0, 5000);
                        $('#purgeConfirmText').val('');
                    } else {
                        displayBarNotification(data.message, 1, 0);
                    }
                },
                error: function () {
                    displayBarNotification('@T("Plugins.Integration.TrendyolMarketplace.Common.Error")', 1, 0);
                },
                complete: function () {
                    btn.prop('disabled', false).html('<i class="fas fa-trash"></i> @T("Plugins.Integration.TrendyolMarketplace.PurgeData.Button")');
                }
            });
        });
    });
</script>
