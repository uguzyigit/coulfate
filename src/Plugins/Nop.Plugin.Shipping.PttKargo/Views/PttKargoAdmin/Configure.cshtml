@model Nop.Plugin.Shipping.PttKargo.Models.ConfigurationModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "PTT Kargo Ayarları";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        <img src="~/Plugins/Shipping.PttKargo/logo.png" alt="PTT Kargo" style="height: 30px;" onerror="this.style.display='none'" />
        PTT Kargo Ayarları
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-controller="PttKargoAdmin" asp-action="Configure" method="post">

            <!-- Pazaryeri Anlaşması -->
            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-handshake"></i> Pazaryeri Anlaşması
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label asp-for="MarketplaceContractEnabled" class="col-form-label"></label>
                        </div>
                        <div class="col-md-9">
                            <div class="form-check">
                                <input asp-for="MarketplaceContractEnabled" class="form-check-input" />
                                <label class="form-check-label">Pazaryeri PTT anlaşması aktif</label>
                            </div>
                            <span class="text-muted">Aktif olduğunda, satıcılar pazaryeri anlaşmasını kullanabilir</span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="MarketplaceMusteriId" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="MarketplaceMusteriId" class="form-control" placeholder="PTT Müşteri Numarası" />
                            <span class="text-muted">PTT tarafından verilen müşteri numarası</span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="MarketplaceSifre" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="MarketplaceSifre" class="form-control" type="password" placeholder="PTT Web Servis Şifresi" />
                            <span class="text-muted">PTT tarafından verilen web servis şifresi</span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"></div>
                        <div class="col-md-9">
                            <button type="button" class="btn btn-info" onclick="testConnection()">
                                <i class="fas fa-plug"></i> Bağlantıyı Test Et
                            </button>
                            <span id="testResult" class="ml-2"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Satıcı Anlaşması -->
            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-store"></i> Satıcı Anlaşması
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label asp-for="AllowVendorContracts" class="col-form-label"></label>
                        </div>
                        <div class="col-md-9">
                            <div class="form-check">
                                <input asp-for="AllowVendorContracts" class="form-check-input" />
                                <label class="form-check-label">Satıcıların kendi PTT anlaşmalarını kullanmasına izin ver</label>
                            </div>
                            <span class="text-muted">Aktif olduğunda, satıcılar kendi PTT credential'larını girebilir</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Test Ortamı -->
            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-flask"></i> Test Ortamı
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label asp-for="UseSandbox" class="col-form-label"></label>
                        </div>
                        <div class="col-md-9">
                            <div class="form-check">
                                <input asp-for="UseSandbox" class="form-check-input" />
                                <label class="form-check-label">Test ortamını kullan (Sandbox)</label>
                            </div>
                            <span class="text-muted">Geliştirme ve test için PTT test ortamını kullanır</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Varsayılan Gönderici Bilgileri -->
            <div class="card card-default">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fas fa-building"></i> Varsayılan Gönderici Bilgileri
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <label asp-for="DefaultSenderName" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="DefaultSenderName" class="form-control" placeholder="Firma Adı" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="DefaultSenderAddress" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="DefaultSenderAddress" class="form-control" placeholder="Adres" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="DefaultSenderCityCode" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="DefaultSenderCityCode" class="form-control" type="number" placeholder="İl Kodu (Örn: 6 = Ankara)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="DefaultSenderDistrictCode" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="DefaultSenderDistrictCode" class="form-control" type="number" placeholder="İlçe Kodu" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="DefaultSenderPhone" class="col-md-3 col-form-label"></label>
                        <div class="col-md-9">
                            <input asp-for="DefaultSenderPhone" class="form-control" placeholder="Telefon (Örn: 05551234567)" />
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Kaydet
                    </button>
                </div>
            </div>

        </form>
    </div>
</section>

<script>
function testConnection() {
    var resultSpan = document.getElementById('testResult');
    resultSpan.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Test ediliyor...';

    $.post('@Url.Action("TestConnection", "PttKargoAdmin")', function(response) {
        if (response.success) {
            resultSpan.innerHTML = '<span class="text-success"><i class="fas fa-check"></i> ' + response.message + '</span>';
        } else {
            resultSpan.innerHTML = '<span class="text-danger"><i class="fas fa-times"></i> ' + response.message + '</span>';
        }
    }).fail(function() {
        resultSpan.innerHTML = '<span class="text-danger"><i class="fas fa-times"></i> Bağlantı hatası</span>';
    });
}
</script>
