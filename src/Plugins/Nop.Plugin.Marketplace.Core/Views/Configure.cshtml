@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    ViewBag.PageTitle = T("Plugins.Marketplace.Core.Configure").Text;
}

<div class="content-header clearfix mb-3">
    <h1 class="float-left">
        @T("Plugins.Marketplace.Core.Configure")
    </h1>
</div>

<form asp-controller="MarketplaceCoreAdmin" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-cogs"></i>
                    @T("Plugins.Marketplace.Core.Configure")
                </div>
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Enabled" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Enabled" />
                        <span asp-validation-for="Enabled"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="RequireVendorApproval" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RequireVendorApproval" />
                        <span asp-validation-for="RequireVendorApproval"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MinimumPayoutAmount" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MinimumPayoutAmount" />
                        <span asp-validation-for="MinimumPayoutAmount"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-save"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
    </div>
</form>

<div class="alert alert-info mt-3">
    <i class="fas fa-info-circle"></i>
    <strong>Bilgi:</strong>
    Satici yonetimi icin NopCommerce'in yerlesik satici sayfasini kullanin:
    <a href="/Admin/Vendor/List" class="alert-link">Saticilar</a>
</div>
