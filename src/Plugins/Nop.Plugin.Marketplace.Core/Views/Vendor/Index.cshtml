@model IList<VendorModel>

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Marketplace.Core.Vendors").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Marketplace.Core.Vendors")
    </h1>
    <div class="float-right">
        <a asp-controller="Vendor" asp-action="Create" asp-area="Admin" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<div class="content">
    <div class="card card-default">
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>@T("Plugins.Marketplace.Core.Fields.Name")</th>
                        <th>@T("Plugins.Marketplace.Core.Fields.Code")</th>
                        <th>@T("Plugins.Marketplace.Core.Fields.Status")</th>
                        <th>@T("Plugins.Marketplace.Core.Fields.ContactEmail")</th>
                        <th>@T("Admin.Common.Edit")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vendor in Model)
                    {
                        <tr>
                            <td>@vendor.Name</td>
                            <td>@vendor.Code</td>
                            <td>
                                @switch (vendor.Status)
                                {
                                    case VendorStatus.Pending:
                                        <span class="badge badge-warning">Beklemede</span>
                                        break;
                                    case VendorStatus.Approved:
                                        <span class="badge badge-info">Onaylandı</span>
                                        break;
                                    case VendorStatus.Active:
                                        <span class="badge badge-success">Aktif</span>
                                        break;
                                    case VendorStatus.Rejected:
                                        <span class="badge badge-danger">Reddedildi</span>
                                        break;
                                    case VendorStatus.Suspended:
                                        <span class="badge badge-secondary">Askıya Alındı</span>
                                        break;
                                }
                            </td>
                            <td>@vendor.ContactEmail</td>
                            <td>
                                <a asp-controller="Vendor" asp-action="Edit" asp-route-id="@vendor.Id" asp-area="Admin" class="btn btn-sm btn-default">
                                    @T("Admin.Common.Edit")
                                </a>
                                <a asp-controller="Vendor" asp-action="Details" asp-route-id="@vendor.Id" asp-area="Admin" class="btn btn-sm btn-info">
                                    Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
