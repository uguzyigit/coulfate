@model Nop.Plugin.Marketplace.VendorApplication.Models.Public.ApplySuccessModel

@{
    Layout = "_ColumnsOne";
    ViewBag.Title = T("Plugins.Marketplace.VendorApplication.Apply.Success.Title").Text;
}

<div class="page vendor-application-success-page">
    <div class="page-title">
        <h1>@T("Plugins.Marketplace.VendorApplication.Apply.Success.Title")</h1>
    </div>
    <div class="page-body">
        <div class="result" style="text-align: center; max-width: 600px; margin: 0 auto;">
            <div class="message-success" style="padding: 20px; margin-bottom: 20px;">
                <p style="font-size: 1.2em;">@T("Plugins.Marketplace.VendorApplication.Apply.Success.Message")</p>
            </div>

            <div class="application-number" style="background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
                <strong>@T("Plugins.Marketplace.VendorApplication.Apply.Success.ApplicationNumber")</strong>
                <br />
                <span class="application-number-value" style="font-size: 2em; font-weight: bold; color: #4caf50;">@Model.ApplicationNumber</span>
            </div>

            <p class="next-steps" style="margin-bottom: 30px; color: #666;">
                @T("Plugins.Marketplace.VendorApplication.Apply.Success.NextSteps")
            </p>

            <div class="buttons" style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;">
                <a href="@Url.Action("Apply", "VendorApplication")" class="button-1" style="padding: 12px 25px; text-decoration: none;">
                    @T("Plugins.Marketplace.VendorApplication.Nav.NewApplication")
                </a>
                <a href="@Model.CheckStatusUrl" class="button-2" style="padding: 12px 25px; text-decoration: none;">
                    @T("Plugins.Marketplace.VendorApplication.Nav.CheckStatus")
                </a>
            </div>
        </div>
    </div>
</div>
