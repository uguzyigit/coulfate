@model Nop.Plugin.Marketplace.VendorApplication.Models.Admin.DocumentTypeListModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Marketplace.VendorApplication.DocumentTypes.Title").Text;
    NopHtml.SetActiveMenuItemSystemName("Marketplace.VendorApplication.DocumentTypes");
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Marketplace.VendorApplication.DocumentTypes.Title")
    </h1>
    <div class="float-right">
        <a href="@Url.Action("DocumentTypeCreate")" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            @T("Plugins.Marketplace.VendorApplication.DocumentTypes.AddNew")
        </a>
    </div>
</div>

<div class="content">
    <div class="card card-default">
        <div class="card-body">
            <table class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.Name")</th>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.Description")</th>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.IsRequired")</th>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.DisplayOrder")</th>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.IsActive")</th>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.AllowedExtensions")</th>
                        <th>@T("Plugins.Marketplace.VendorApplication.DocumentTypes.MaxFileSize")</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DocumentTypes)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>
                                @if (item.IsRequired)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times text-muted"></i>
                                }
                            </td>
                            <td>@item.DisplayOrder</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Inactive</span>
                                }
                            </td>
                            <td>@item.AllowedExtensions</td>
                            <td>@item.MaxFileSizeKb KB</td>
                            <td>
                                <a href="@Url.Action("DocumentTypeEdit", new { id = item.Id })" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i>
                                    @T("Plugins.Marketplace.VendorApplication.DocumentTypes.Edit")
                                </a>
                                <form asp-action="DocumentTypeDelete" method="post" style="display: inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">
                                        <i class="fas fa-trash"></i>
                                        @T("Plugins.Marketplace.VendorApplication.DocumentTypes.Delete")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
