@model Nop.Plugin.Marketplace.VendorApplication.Models.Admin.DocumentTypeModel

@{
    Layout = "_AdminLayout";
    var isEdit = Model.Id > 0;
    ViewBag.PageTitle = isEdit
        ? T("Plugins.Marketplace.VendorApplication.DocumentTypes.EditTitle").Text
        : T("Plugins.Marketplace.VendorApplication.DocumentTypes.CreateTitle").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @ViewBag.PageTitle
    </h1>
    <div class="float-right">
        <a href="@Url.Action("DocumentTypes")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i>
            @T("Plugins.Marketplace.VendorApplication.Admin.Detail.BackToList")
        </a>
    </div>
</div>

<div class="content">
    <form asp-action="@(isEdit ? "DocumentTypeEdit" : "DocumentTypeCreate")" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Name" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Name" />
                        <span asp-validation-for="Name"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Description" />
                    </div>
                    <div class="col-md-9">
                        <nop-textarea asp-for="Description" />
                        <span asp-validation-for="Description"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="IsRequired" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsRequired" />
                        <span asp-validation-for="IsRequired"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DisplayOrder" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="DisplayOrder" />
                        <span asp-validation-for="DisplayOrder"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="IsActive" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsActive" />
                        <span asp-validation-for="IsActive"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AllowedExtensions" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AllowedExtensions" />
                        <span asp-validation-for="AllowedExtensions"></span>
                        <span class="hint">@T("Plugins.Marketplace.VendorApplication.DocumentTypes.AllowedExtensions.Hint")</span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="MaxFileSizeKb" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MaxFileSizeKb" />
                        <span asp-validation-for="MaxFileSizeKb"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" name="save" class="btn btn-primary">
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
    </form>
</div>
