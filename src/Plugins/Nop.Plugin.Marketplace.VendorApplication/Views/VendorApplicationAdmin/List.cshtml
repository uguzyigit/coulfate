@model Nop.Plugin.Marketplace.VendorApplication.Models.Admin.ApplicationListModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Marketplace.VendorApplication.Admin.List.Title").Text;
    NopHtml.SetActiveMenuItemSystemName("Marketplace.VendorApplication.List");
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Marketplace.VendorApplication.Admin.List.Title")
    </h1>
</div>

<div class="content">
    <div class="form-horizontal">
        <div class="card card-default card-search">
            <div class="card-body">
                <form asp-controller="VendorApplicationAdmin" asp-action="List" method="get">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>@T("Plugins.Marketplace.VendorApplication.Admin.List.SearchStatus")</label>
                                <select name="statusId" class="form-control" asp-items="Model.AvailableStatuses"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>@T("Plugins.Marketplace.VendorApplication.Admin.List.SearchTerm")</label>
                                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group" style="margin-top: 30px;">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i>
                                    @T("Plugins.Marketplace.VendorApplication.Admin.List.Search")
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-body">
                <table class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.ApplicationNumber")</th>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.CompanyName")</th>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.ContactPerson")</th>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.Email")</th>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.Status")</th>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.CreatedOn")</th>
                            <th>@T("Plugins.Marketplace.VendorApplication.Admin.List.Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Applications)
                        {
                            <tr>
                                <td>@item.ApplicationNumber</td>
                                <td>@item.CompanyName</td>
                                <td>@item.ContactPerson</td>
                                <td>@item.Email</td>
                                <td>
                                    <span class="badge badge-@GetStatusBadgeClass(item.Status)">
                                        @item.StatusName
                                    </span>
                                </td>
                                <td>@item.CreatedOnUtc.ToString("g")</td>
                                <td>
                                    <a href="@Url.Action("Detail", "VendorApplicationAdmin", new { id = item.Id })" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i>
                                        @T("Plugins.Marketplace.VendorApplication.Admin.List.View")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination justify-content-center">
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("List", new { page = i, statusId = Model.SearchStatusId, searchTerm = Model.SearchTerm })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus status)
    {
        return status switch
        {
            Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus.Pending => "warning",
            Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus.UnderReview => "info",
            Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus.DocumentsRequested => "secondary",
            Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus.Approved => "success",
            Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus.Rejected => "danger",
            Nop.Plugin.Marketplace.VendorApplication.Domain.VendorApplicationStatus.Cancelled => "dark",
            _ => "secondary"
        };
    }
}
