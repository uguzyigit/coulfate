@model FooterModel

@using Nop.Core
@using Nop.Core.Domain.Tax

@inject IWorkContext workContext

<footer class="footer pacific-footer">
    <div class="pacific-footer-main footer-upper">
        <div class="pacific-container">
            <div class="pacific-footer-grid">
                <!-- Column 1: Logo & Contact -->
                <div class="pacific-footer-column pacific-footer-about-column">
                    <div class="pacific-footer-logo">
                        @await Component.InvokeAsync(typeof(LogoViewComponent))
                    </div>
                    <p class="pacific-footer-about">
                        @T("Footer.About.Text", "Your trusted online store for quality products. We deliver excellence with every order.")
                    </p>
                    <div class="pacific-footer-contact">
                        <div class="pacific-footer-contact-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                            </svg>
                            <span>@T("Footer.Contact.Address", "123 Store Street, City, Country")</span>
                        </div>
                        <div class="pacific-footer-contact-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                            </svg>
                            <span>@T("Footer.Contact.Phone", "+1 234 567 890")</span>
                        </div>
                        <div class="pacific-footer-contact-item">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                            </svg>
                            <span>@T("Footer.Contact.Email", "info@store.com")</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Menu (includes Information and Customer Service) -->
                @await Component.InvokeAsync(typeof(FooterMenuViewComponent))

                <!-- Column 4: Newsletter & Social -->
                <div class="pacific-footer-column">
                    <h4 class="pacific-footer-title">@T("Footer.Newsletter")</h4>
                    <p class="pacific-newsletter-text">
                        @T("Footer.Newsletter.Text", "Subscribe to our newsletter and get exclusive deals.")
                    </p>
                    @await Component.InvokeAsync(typeof(NewsLetterBoxViewComponent))

                    <div class="footer-block follow-us" style="margin-top: 30px;">
                        <div class="social">
                            <h4 class="pacific-footer-title">@T("Footer.FollowUs")</h4>
                            @await Component.InvokeAsync(typeof(SocialButtonsViewComponent))
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="pacific-footer-bottom footer-lower">
        <div class="pacific-container">
            <div class="pacific-copyright footer-info">
                <span class="footer-disclaimer">@T("Content.CopyrightNotice", DateTime.Now.Year, Model.StoreName)</span>
                @if (Model.DisplayTaxShippingInfoFooter)
                {
                    var inclTax = await workContext.GetTaxDisplayTypeAsync() == TaxDisplayType.IncludingTax;
                    <span class="footer-tax-shipping">
                        @T(inclTax ? "Footer.TaxShipping.InclTax" : "Footer.TaxShipping.ExclTax", Url.RouteUrl("Topic", new { SeName = "shippinginfo" }))
                    </span>
                }
            </div>
            @if (!Model.HidePoweredByNopCommerce)
            {
                <div class="footer-powered-by">
                    Powered by <a href="https://www.nopcommerce.com/" target="_blank" @(Model.IsHomePage ? string.Empty : "rel=nofollow")>nopCommerce</a>
                </div>
            }
        </div>
    </div>

    @await Component.InvokeAsync(typeof(StoreThemeSelectorViewComponent))
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.Footer, additionalData = Model })
</footer>

<script asp-location="Footer">
    $(function() {
        $('.block .title, .pacific-footer-title').on('click', function () {
            var e = window, a = 'inner';
            if (!('innerWidth' in window)) {
                a = 'client';
                e = document.documentElement || document.body;
            }
            var result = { width: e[a + 'Width'], height: e[a + 'Height'] };
            if (result.width < 769) {
                $(this).siblings('.listbox, .pacific-footer-links').slideToggle('slow');
                $(this).toggleClass('is-open');
            }
        });
    });
</script>
