@model IList<CategoryModel>

@using Nop.Core.Domain.Catalog

@if (Model.Count > 0)
{
    <section class="home-page-category-grid">
        <div class="pacific-container">
            <h2 class="title">@T("Homepage.Categories", "Shop by Category")</h2>
            <div class="category-grid">
                <div class="item-grid">
                    @foreach (var item in Model)
                    {
                        <div class="item-box">
                            <a href="@Url.RouteUrl("Category", new { SeName = item.SeName })" title="@item.PictureModel.Title">
                                <div class="picture">
                                    <img alt="@item.PictureModel.AlternateText"
                                         src="@item.PictureModel.ImageUrl"
                                         title="@item.PictureModel.Title"
                                         loading="lazy" />
                                </div>
                                <div class="title">
                                    <span>@item.Name</span>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}
