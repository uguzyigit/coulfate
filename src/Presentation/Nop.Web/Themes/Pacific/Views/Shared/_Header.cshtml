@using Nop.Core
@inject IWorkContext workContext

<header class="header pacific-header">
    <a class="skip visually-hidden" href="#main">@T("Header.SkipNavigation.Text")</a>

    <!-- USP Bar -->
    <div class="pacific-usp-bar">
        <div class="pacific-container">
            <div class="pacific-usp-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
                <span>@T("Pacific.UspBar.FreeShipping", "Free Shipping Over $50")</span>
            </div>
            <div class="pacific-usp-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                <span>@T("Pacific.UspBar.FastDelivery", "Fast Delivery")</span>
            </div>
            <div class="pacific-usp-item">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                <span>@T("Pacific.UspBar.SecurePayment", "Secure Payment")</span>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })

    <!-- Main Header -->
    <div class="pacific-header-main">
        <div class="pacific-container">
            <!-- Logo -->
            <div class="pacific-logo header-logo">
                @await Component.InvokeAsync(typeof(LogoViewComponent))
            </div>

            <!-- Search Box -->
            <div class="pacific-search" role="search">
                @await Component.InvokeAsync(typeof(SearchBoxViewComponent))
            </div>

            <!-- Header Actions -->
            <div class="pacific-header-actions">
                <!-- Selectors (Currency/Language) -->
                <div class="pacific-header-selectors">
                    @await Component.InvokeAsync(typeof(CurrencySelectorViewComponent))
                    @await Component.InvokeAsync(typeof(LanguageSelectorViewComponent))
                </div>

                <!-- Account -->
                <a href="@Url.RouteUrl("CustomerInfo")" class="pacific-header-action" title="@T("Account.MyAccount")">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                    <span>@T("Account.MyAccount")</span>
                </a>

                <!-- Wishlist -->
                <a href="@Url.RouteUrl("Wishlist")" class="pacific-header-action" title="@T("Wishlist")">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    <span>@T("Wishlist")</span>
                </a>

                <!-- Shopping Cart -->
                <div class="pacific-header-cart">
                    @await Component.InvokeAsync(typeof(FlyoutShoppingCartViewComponent))
                </div>
            </div>
        </div>
    </div>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderMiddle })

    <!-- Navigation -->
    <nav class="pacific-nav">
        <div class="pacific-container">
            @await Component.InvokeAsync(typeof(MainMenuViewComponent))
        </div>
    </nav>

    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
</header>
